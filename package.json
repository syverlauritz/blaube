{
  "name": "blaube",
  "productName": "Blaube",
  "version": "0.1.0",
  "description": "A squishy softbody desktop buddy you can toss around, that keeps an eye on your Claude Code sessions.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Syver Lauritz",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "app.blaube.desktop",
    "productName": "Blaube",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/trayTemplate*.png",
      "build/tray*.png"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
