{
  "name": "blaube",
  "productName": "Blaube",
  "version": "0.2.0",
  "description": "A squishy softbody desktop buddy you can toss around, that keeps an eye on your Claude Code sessions.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Syver Lauritz",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "electron-builder --win --x64 && electron-builder --win --arm64",
    "build:mac:local": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --publish never",
    "shots": "electron scripts/shots/main.js",
    "e2e": "BLAUBE_TEST=scripts/e2e/talk.js BLAUBE_PORT=47870 electron .",
    "e2e:start": "BLAUBE_TEST=scripts/e2e/start.js BLAUBE_PORT=47871 electron .",
    "e2e:life": "BLAUBE_TEST=scripts/e2e/life.js BLAUBE_PORT=47872 electron .",
    "e2e:grab": "BLAUBE_TEST=scripts/e2e/grab.js BLAUBE_PORT=47877 electron .",
    "e2e:blobs": "BLAUBE_TEST=scripts/e2e/blobs.js BLAUBE_PORT=47878 electron ."
  },
  "build": {
    "appId": "app.blaube.desktop",
    "productName": "Blaube",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/trayTemplate*.png",
      "build/tray*.png"
    ],
    "asarUnpack": [
      "src/main/win/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
